---
import Icon, { type IconName } from './Icon.astro';

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: 'monitor', title: 'Real foreground time', text: 'Which window had focus, every 2 seconds, and when the session was locked. Not process uptime.' },
  { icon: 'smartphone', title: 'Phones too', text: 'Screen-on time, unlocks and app sessions, rebuilt from Android\'s own usage events.' },
  { icon: 'database', title: 'History that stays', text: 'Every hour into SQLite on a second drive, with a consistent backup beside it.' },
  { icon: 'copyCheck', title: 'Opens are visits', text: 'Switching away and straight back, or between screens of one app, counts once.' },
  { icon: 'merge', title: 'Your own grouping', text: 'Rename, recolour, hide or merge any app; it is stored with the history.' },
  { icon: 'layoutGrid', title: 'Table or grid', text: 'Every app as a table, or as cards with its figures large.' },
  { icon: 'clock', title: 'A range per chart', text: 'Every page covers all history; each day-by-day chart has its own 7d to All menu.' },
  { icon: 'rotateCcw', title: 'Survives a reset', text: '<code>npm run restore</code> puts it back; <code>npm run drill</code> rehearses it.' },
];
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Features</p>
      <h2 id="features-title">Time in front of you, kept.</h2>
      <p class="lead">It records what was actually in focus, checks it against Android's Digital Wellbeing, and keeps every day.</p>
    </div>
    <ul class="grid features">
      {
        features.map((f) => (
          <li class="card">
            <span class="icon-tile"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p class="muted" set:html={f.text} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    --col-min: 240px;
    padding: 0;
    list-style: none;
  }

  .features h3 {
    margin-bottom: 6px;
  }

  .features p {
    font-size: 0.9375rem;
  }
</style>
