---
import Icon, { type IconName } from './Icon.astro';

const tiles: { icon: IconName; title: string; text: string }[] = [
  { icon: 'cloudOff', title: 'No cloud', text: 'No account, no telemetry. The one optional connection is the phones\' sealed inbox.' },
  { icon: 'lock', title: 'Password-gated', text: 'Every page and API, and it fails closed: no password, no access.' },
  { icon: 'fileSearch', title: 'No window titles', text: 'It records which app and for how long, never the document or page on screen.' },
  { icon: 'shield', title: 'No elevation', text: 'The sampler and the ingest run as you. Nothing asks for Administrator.' },
];
---

<section class="section" id="privacy" aria-labelledby="privacy-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Privacy</p>
      <h2 id="privacy-title">Your history stays on your PC.</h2>
      <p class="lead">It records what you looked at and when, so it is gated, local, and records as little as the numbers need.</p>
    </div>
    <ul class="grid tiles">
      {
        tiles.map((t) => (
          <li class="card">
            <span class="icon-tile"><Icon name={t.icon} /></span>
            <h3>{t.title}</h3>
            <p class="muted">{t.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tiles {
    --col-min: 220px;
    padding: 0;
    list-style: none;
  }

  .tiles h3 {
    margin-bottom: 4px;
  }

  .tiles p {
    font-size: 0.9375rem;
  }
</style>
