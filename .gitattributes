# The Gradle wrapper script must stay LF. It is a POSIX shell script, and with
# core.autocrlf on (the default here) a fresh clone would check it out with CRLF
# and `./gradlew` would fail with "bad interpreter: No such file or directory".
# Like the task XML above, this only bites during recovery on a rebuilt machine,
# which is the worst possible moment to discover it.
android/gradlew text eol=lf

# The wrapper jar is a binary and must never be eol-normalised.
android/gradle/wrapper/gradle-wrapper.jar binary

# Batch files must be CRLF. cmd.exe reads a .bat line at a time AS IT RUNS,
# and an LF-only file can misparse a label or a parenthesised block -- which
# shows up as a launcher that half-works rather than as a syntax error.
*.bat text eol=crlf
